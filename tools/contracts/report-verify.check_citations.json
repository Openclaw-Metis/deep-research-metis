{
  "id": "report-verify.check_citations",
  "version": "1.2.0",
  "description": "比對行內引用、書目條目與來源帳本並產生引用對應表，支援 [1, 2]、[1-3]、全形括號與編號清單書目；實際引用來源少於計畫下限時回報 warning。",
  "input_schema": {
    "type": "object",
    "properties": {
      "run_dir": {
        "type": "string",
        "description": "研究執行工作區的絕對或相對路徑，必須位於 skill 資料夾之外。"
      },
      "report_markdown": {
        "type": "string",
        "description": "報告 Markdown 全文；與 report_path 擇一提供。"
      },
      "report_path": {
        "type": "string",
        "description": "工作區內的報告檔案路徑；與 report_markdown 擇一提供。"
      }
    },
    "required": [
      "run_dir"
    ],
    "additionalProperties": false
  },
  "semantic_validations": [
    {
      "rule_id": "citation.sources-not-registered",
      "description": "來源帳本為空時無法驗證引用鏈。",
      "failure_action": "block"
    },
    {
      "rule_id": "report.source-required",
      "description": "必須提供 report_markdown 或 report_path。",
      "failure_action": "block"
    }
  ],
  "output": {
    "type": "object",
    "description": "包含 citation_map、counts 與 findings 的引用檢查結果。"
  },
  "result_policy": {
    "validate_output_schema": true,
    "sensitive_data_classes": [
      "none"
    ],
    "redaction_rules": [
      "移除任何 credential 或 token 類欄位後才回傳結果"
    ],
    "max_inline_bytes": 65536,
    "overflow_action": "summarize"
  },
  "important_preconditions": [
    "來源已登錄",
    "報告已含書目章節"
  ],
  "effects": {
    "effect_classes": [
      "read",
      "write"
    ],
    "reads_input": true,
    "creates_resource": true,
    "modifies_input": false,
    "external_write": false,
    "destructive": false,
    "data_egress": false,
    "incurs_cost": false,
    "privileged_access": false,
    "requires_approval": false
  },
  "approval_policy": {
    "mode": "not-required",
    "scope": null,
    "bind_to_target": false,
    "bind_to_subject": true,
    "expiry_required": false
  },
  "important_errors": [
    "INVALID_ARGUMENT",
    "SEMANTIC_VALIDATION_FAILED"
  ]
}
